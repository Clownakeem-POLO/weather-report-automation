# Copy this file to .env and fill in real values to enable emailing.
# The tool reads these from the environment. If any required one is missing,
# it skips emailing and just saves the report files locally.
# Never commit a filled-in .env. It is listed in .gitignore.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=ops-reports@example.com
# Comma-separated list of recipients.
SMTP_TO=site-leads@example.com,planner@example.com
